# Decryption services for fire (MT6768) - HyperOS 2 / Android 15
# SPDX-License-Identifier: Apache-2.0

# --- Keymaster / Gatekeeper HAL ---
service vendor.keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service.trustkernel
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# --- HWBINDER / Servicemanager ---
on property:hwservicemanager.ready=true
    start vendor.keymaster-4-0
    start gatekeeper-1-0

# --- vold for FBE decrypt ---
on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

# --- Wait for metadata ---
on fs
    wait /dev/block/by-name/metadata
    mount ext4 /dev/block/by-name/metadata /metadata noatime discard

# --- FBE Policy ---
on post-fs-data
    setprop vold.post_fs_data_done 1
